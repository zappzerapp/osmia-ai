# Osmia configuration template
# Tip: `osmia-ai init config.yaml` starts an interactive wizard that generates this file for you.

llm:
  model: "kimi-k2.5"
  apiUrl: "https://ollama.com/api/chat"
  timeout: 60000
  maxRetries: 3
  requestsPerMinute: 30
  maxConcurrency: 1
  apiKeyEnv: "OLLAMA_API_KEY"
  structuredOutput: true

research:
  searchQuery: "Product {name} {sku} specifications overview"
  maxResults: 5
  region: "de-de"
  timeoutMs: 10000
  maxRetries: 3
  requestsPerMinute: 30
  maxConcurrency: 1
  # Fetch full, readability-cleaned page content for each result URL (slower, better extraction).
  fetchPageContent: false
  maxPageChars: 8000
  pageFetchTimeoutMs: 15000
  pageFetchMaxRetries: 2
  pageFetchRequestsPerMinute: 20
  pageFetchMaxConcurrency: 2

extraction:
  prompt: |-
    You enrich records using public web information.
    Use the search results to extract only facts that are supported by the sources.
    If a value cannot be determined confidently, return null or an empty value that still matches the schema.

    Respond ONLY as a JSON object.

  schema:
    summary:
      type: "string"
      description: "Short factual summary"
    category:
      type: "string"
      description: "Most likely category"
  # Attach the URLs (and titles) of the search results used for each record as a
  # `_<name>` array on the output, so enrichments are machine-checkable against their origins.
  includeSources: false
  sourcesField: _sources
